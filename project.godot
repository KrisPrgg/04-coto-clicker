;   param=value ; assign values to parameters

config_version=5

[application]

config/name="04_COTO_CLICKER"
run/main_scene="uid://ej53w0lna7e8"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"

[autoload]

Global="*uid://c4xj742d07f3m"

[display]

window/size/viewport_width=120
window/size/viewport_height=213
window/size/mode=2
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[dotnet]

project/assembly_name="04_COTO_CLICKER"

